# Ollama (local LLM server — run `ollama serve` on the host; not provided by Docker in this project)
OLLAMA_BASE_URL=http://localhost:11434
# If the Streamlit app runs inside Docker, use host.docker.internal instead (set in docker-compose.yml).

# Models (must be pulled in Ollama)
# OCR: typhoon-ocr1.5-3b needs ~10 GiB system RAM in Ollama — too little RAM → use a small vision model instead, e.g.:
#   OCR_MODEL=moondream
#   ollama pull moondream
# (Thai quality may be worse than Typhoon; increase Docker/host RAM to use typhoon again.)
OCR_MODEL=scb10x/typhoon-ocr1.5-3b:latest
LLM_MODEL=qwen3.5:0.6b
EMBEDDING_MODEL=qwen3-embedding:8b
RERANKER_MODEL=qwen3-reranker:4b

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=documents

# Chunking
CHUNK_SIZE=600
CHUNK_OVERLAP=100
